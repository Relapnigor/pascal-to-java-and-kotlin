start: program

program: tokens*

tokens: KEYWORD
        | STRING
        | CHAR
        | TYPE
        | NUMBER
        | WORD

KEYWORD.3: /\bfun\b/
        | /\bwhile\b/
        | /\bfor\b/
        | /\bif\b/
        | /\bvar\b/
        | /\bval\b/
        | /\belse\b/
        | /\breturn\b/
        | /\btrue\b/
        | /\bfalse\b/
        | /\bwhen\b/
        | /\bdo\b/
        | /\bbreak\b/
        | /\bcontinue\b/
        | /\bnull\b/
        | /\bdefault\b/

WORD: /[a-zA-Z_][a-zA-Z0-9_]*/
    | /\+=|-=|\*=|\/=|%=|==|!=|>=|<=/
    | /\.\./
    | /\|\|/
    | /\&\&/
    | /[\+\-\/\*%><=\[\]\{\}\(\);:,'.\!]/

STRING.2: /"[^"]*"/
CHAR.2:  /'([^'\\]|\\.)*'/

TYPE.2: /\bInt\b/
        | /\bByte\b/
        | /\bShort\b/
        | /\bLong\b/
        | /\bFloat\b/
        | /\bDouble\b/
        | /\bBoolean\b/
        | /\bChar\b/
        | /\bString\b/

%import common.WS
%ignore WS
%import common.NUMBER